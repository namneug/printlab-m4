# คัดลอกเป็น .env (ห้าม commit .env)
# ปลายทางรับ event (Vercel: /api/events) — เว้นว่างเมื่อ deploy บน GitHub Pages ข้อมูลจะเก็บในเครื่องและส่งออกเป็นไฟล์
VITE_EVENTS_ENDPOINT=
# ขนาดรายชื่อรหัสนิรนาม ANON-001..ANON-0NN
VITE_ROSTER_SIZE=50
# แสดง event ใน console แม้ตอน build (1 = เปิด)
VITE_DEBUG_EVENTS=0
# รหัสผ่านแดชบอร์ดครู (/teacher/)
VITE_TEACHER_PASSWORD=
# URL โมเดล glTF ถ้าต้องการแทนที่โมเดล primitive
VITE_PRINTER_MODEL_URL=

# ---- ฝั่งเซิร์ฟเวอร์ (Vercel functions) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# พี่เลี้ยง: rule (เฟส 1) หรือ llm (เฟส 2 ต้องมี api/mentor.ts + ANTHROPIC_API_KEY ฝั่งเซิร์ฟเวอร์)
VITE_MENTOR_PROVIDER=rule
